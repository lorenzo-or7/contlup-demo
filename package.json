{
  "name": "contlup-demo",
  "private": true,
  "type": "module",
  "description": "Site da ContLup Studio Contábil com a assistente virtual Lupi 2.0",
  "scripts": {
    "serve": "node tests/support/static-server.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\" \"tests/security/*.test.mjs\"",
    "test:ui": "node --test --test-concurrency=1 \"tests/ui/*.test.mjs\"",
    "test:live": "node --test \"tests/live/*.test.mjs\"",
    "test:all": "npm test && npm run test:ui && npm run test:live",
    "eval": "node eval/run.mjs",
    "worker:dev": "cd worker && npx wrangler dev",
    "worker:deploy": "cd worker && npx wrangler deploy"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
