# Lupi 2.0 — exemplo de variáveis (SEM credenciais reais).
# Copie para ".env" (ignorado pelo Git) apenas para rodar a avaliação comparativa (npm run eval)
# e os testes com IA real (npm run test:live) no seu computador.
# Para o servidor publicado, use "npx wrangler secret put" (veja docs/LUPI-2.md).

# Chaves (secrets)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Modelos atuais — consulte a documentação de cada provedor antes de preencher:
#   https://ai.google.dev/gemini-api/docs/models
#   https://platform.openai.com/docs/models
GEMINI_MODEL=
OPENAI_MODEL=

# Opcionais
# GEMINI_THINKING_BUDGET=0
# OPENAI_REASONING_EFFORT=
# AI_TEMPERATURE=
MAX_OUTPUT_TOKENS=700
PROVIDER_TIMEOUT_MS=15000

# Preços por 1 milhão de tokens em US$ (preencha com a tabela oficial vigente; vazio = custo não calculado)
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
